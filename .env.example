# ===== CƠ SỞ DỮ LIỆU =====
# Khi chạy bằng docker compose (khuyến nghị) giữ nguyên dòng dưới
DATABASE_URL="postgresql://bandoso:bandoso@localhost:5432/bandoso"

# ===== BẢO MẬT TRANG QUẢN TRỊ =====
# Chuỗi bí mật để ký phiên đăng nhập – đổi thành chuỗi ngẫu nhiên dài >= 32 ký tự
AUTH_SECRET="doi-chuoi-nay-thanh-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu"
# Tài khoản quản trị tạo lần đầu khi chạy seed
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="Admin@123456"

# ===== ĐỊA CHỈ WEB =====
# Dùng để sinh mã QR và link chia sẻ. Khi đưa lên mạng đổi thành tên miền thật
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ===== BẢN ĐỒ =====
# Để trống -> dùng bản đồ nền OpenFreeMap (miễn phí, không cần khóa)
# Có khóa Goong (https://account.goong.io) -> dùng bản đồ Goong, địa danh tiếng Việt tốt hơn
NEXT_PUBLIC_GOONG_MAPTILES_KEY=""
# (Nâng cao) Tự chỉ định URL style bản đồ MapLibre khác – thường để trống
NEXT_PUBLIC_MAP_STYLE_URL=""
